#include <stdio.h>
#include <stdlib.h> //malloc (memory allocation), realloc

typedef struct Node No;

struct Node{
    int dado;
    struct Node *proximo;
};

void inserirInicio(No** head, int valor){
    No* novo = malloc(sizeof(No));
    novo->dado = valor;
    novo->proximo = *head;
    *head = novo; 
}

void imprimirLista(No* head){
    No* atual = head;
    while (atual != NULL){
        printf("%d -> ", atual->dado);
        atual = atual->proximo;
    }
    printf("NULL\n");
}

No* buscar(No* head, int alvo){
    No* atual = head;
    while(atual != NULL){
        if(atual->dado == alvo)return atual;
        atual = atual->proximo;
    }
    return NULL;
}
